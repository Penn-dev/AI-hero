{
  "type": "object",
  "properties": {
    "articleId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "dictionary",
        "workshop-lesson"
      ]
    },
    "start": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "summary",
        "cards"
      ],
      "additionalProperties": false
    },
    "prerequisiteIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "sourceBasis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "term",
          "aliases",
          "definition",
          "sourceBasis"
        ],
        "additionalProperties": false
      }
    },
    "bodyTitle": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "title",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "description",
          "href",
          "format"
        ],
        "additionalProperties": false
      }
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "afterSource": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "markdown": {
            "type": "string",
            "minLength": 1
          },
          "sourceBasis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "afterSource",
          "markdown",
          "sourceBasis"
        ],
        "additionalProperties": false
      }
    },
    "sourceGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "articleId",
    "kind",
    "start",
    "prerequisiteIds",
    "glossary",
    "bodyTitle",
    "check",
    "related",
    "explanations",
    "sourceGaps"
  ],
  "additionalProperties": false
}
