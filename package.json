  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "sample:prepare": "node scripts/build-pilot-index.mjs && node scripts/validate-pilot.mjs content/pilots/v2/sol-medium/a-complete-guide-to-agents-md.md && node scripts/publish-sample.mjs && node scripts/validate-content.mjs",
    "sync:source": "node scripts/sync-content.mjs",
    "sync:translate": "node scripts/translate-content.mjs",
    "sync:check": "node scripts/translate-content.mjs --dry-run",
    "sync:validate": "node scripts/validate-content.mjs",
    "learning:validate": "node scripts/validate-learning-pages.mjs",
    "page:assemble": "node scripts/assemble-page.mjs",
    "page:test": "node --test scripts/assemble-page.test.mjs scripts/localized-article.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
